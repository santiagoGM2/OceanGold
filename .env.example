# Webhook de GoHighLevel para recibir leads del formulario
# Obtener desde: GHL > Automation > Workflows > "Recepción Landing Ocean Gold" > Webhook trigger
GHL_WEBHOOK_URL=

# URL del calendario de booking de GHL (iframe embed)
NEXT_PUBLIC_GHL_CALENDAR_URL=https://api.leadconnectorhq.com/widget/booking/gSMbRpfe4CCHqTBkOQZA

# Número de WhatsApp de Ocean Gold Miami en formato E.164 sin + (e.g. 13055551234)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Token de Vercel Blob para storage de fotos del formulario
# Generar desde: Vercel Dashboard > Storage > Create Blob Store > .env.local
BLOB_READ_WRITE_TOKEN=

# URL canónica del sitio en producción (sin barra final)
NEXT_PUBLIC_SITE_URL=https://oceangold.example.com
